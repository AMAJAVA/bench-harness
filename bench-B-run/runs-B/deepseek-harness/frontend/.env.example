# URL de base de l'API TeamLeave, incluant le préfixe de version.
# En développement, laisser la valeur par défaut "/api/v1" : Vite proxifie /api
# vers le backend (voir VITE_API_PROXY_TARGET).
VITE_API_BASE_URL=/api/v1

# Cible du proxy de développement Vite (backend ASP.NET Core local).
VITE_API_PROXY_TARGET=http://localhost:5080
