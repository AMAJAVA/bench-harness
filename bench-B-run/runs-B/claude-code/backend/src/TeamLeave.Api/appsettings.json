{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TeamLeave": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "teamleave-api",
    "Audience": "teamleave-spa",
    "LifetimeMinutes": 60,
    "ClockSkewSeconds": 30,
    "SigningKeys": {
      "Current": "",
      "Previous": ""
    }
  },
  "PasswordHashing": {
    "Iterations": 210000
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "From": "teamleave@pme.fr"
  },
  "Notifications": {
    "DispatcherEnabled": true,
    "PollIntervalSeconds": 30
  },
  "RateLimiting": {
    "LoginPermitLimit": 10
  },
  "Seed": {
    "Holidays": true,
    "InitialAdminEmail": "",
    "InitialAdminTemporaryPassword": ""
  },
  "App": {
    "PublicBaseUrl": "https://teamleave.pme.fr"
  }
}
